/*
 * gbversion.h is generated from gbversion.h.in which uses autoconf voodoo
 * to get the version number from configure.ac.
 *
 * Isn't simplification via automation grand?
 */
#ifdef RC_INVOKED
// These defines are for the Microsoft resource compiler scripts
// win32/gpsbabel.rc and gui/app.rc
#define VER_FILE @GB.MAJOR@,@GB.MINOR@,@GB.MICRO@,@GB.BUILD@
#define VER_PRODUCT @GB.MAJOR@,@GB.MINOR@,@GB.MICRO@,@GB.BUILD@
#define VER_FILE_STR "@GB.MAJOR@.@GB.MINOR@.@GB.MICRO@@GB.PACKAGE_RELEASE@"
#define VER_PRODUCT_STR "@GB.MAJOR@.@GB.MINOR@.@GB.MICRO@@GB.PACKAGE_RELEASE@"
#define VER_COPYRIGHT_STR L"\x00a9 2002-@GB.COPYRIGHT_YEAR@ Robert Lipe"
#else
#ifndef GBVERSION_H_INCLUDED_
#define GBVERSION_H_INCLUDED_

#include <QString>

class GBVersion
{
public:
  static const QString& version()
  {
    return kVersion;
  }
  static const QString& versionSHA()
  {
    return kVersionSHA;
  }
  static const QString& versionDate()
  {
    return kVersionDate;
  }
  static const QString& webDocDir()
  {
    return kWebDocDir;
  }
  static const QString& appName()
  {
    return kAppName;
  }

private:
  inline static const QString kVersion = QStringLiteral("@GB.MAJOR@.@GB.MINOR@.@GB.MICRO@@GB.PACKAGE_RELEASE@");
  inline static const QString kVersionSHA = QStringLiteral("@GB.SHA@");
  inline static const QString kVersionDate = QStringLiteral("@GB.DATE@");
  inline static const QString kWebDocDir = QStringLiteral("https://www.gpsbabel.org/htmldoc-@GPSBABEL_DOCVERSION@");
  inline static const QString kAppName = QStringLiteral("GPSBabel");
};
#endif // GBVERSION_H_INCLUDED_
#endif
